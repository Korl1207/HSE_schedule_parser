# HSE account credentials (used only for the first login / when the SSO
# session has expired — normal runs reuse the saved session cookies instead)
HSE_USERNAME=login@edu.hse.ru
HSE_PASSWORD=

# Where to keep local state (defaults to ./data/... next to this file if unset)
# DB_PATH=./data/schedule.db
# STATE_DIR=./data/state

# How many upcoming weeks (Mondays) to fetch on each sync
WEEKS_AHEAD=4

# Google Calendar sync
# ---------------------
# 1. Google Cloud Console -> new project -> enable "Google Calendar API"
# 2. APIs & Services -> Credentials -> Create Credentials -> OAuth client ID
#    -> Application type: Desktop app
# 3. Download the JSON and save it as data/state/client_secret.json
#    (or point GOOGLE_CLIENT_SECRET at wherever you put it)
# 4. Run `python3 run_calendar_sync.py` once by hand — it opens a browser
#    for a one-time consent screen, then never needs one again.
#
# All of these default to files under data/state/ if left unset:
# GOOGLE_CLIENT_SECRET=./data/state/client_secret.json
# GOOGLE_TOKEN_PATH=./data/state/google_token.json
# GOOGLE_CALENDAR_ID_PATH=./data/state/google_calendar_id.txt

# Name of the dedicated secondary calendar the bot creates on first run and
# only ever writes to (never touches your primary calendar's events)
GOOGLE_CALENDAR_NAME=HSE Пары
